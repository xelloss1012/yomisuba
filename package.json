{
  "name": "yomisuba",
  "description": "Yomisuba (読みの素晴らしい世界に祝福を！): EPUB reader for vertical Japanese with furigana, dictionaries and translation.",
  "homepage": "https://github.com/xelloss1012/yomisuba#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xelloss1012/yomisuba.git"
  },
  "bugs": "https://github.com/xelloss1012/yomisuba/issues",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && cap sync android && node scripts/build-android.mjs release",
    "build:web": "tsc && vite build",
    "dictionary:test": "node scripts/test-dictionary-search.mjs",
    "favorites:test": "node scripts/test-translation-favorites.mjs",
    "frequent:test": "node scripts/test-frequent-queries.mjs",
    "history:test": "node scripts/test-translation-history.mjs",
    "i18n:test": "node scripts/test-i18n.mjs",
    "wiktionary-dictionary:test": "node scripts/test-wiktionary-dictionary-build.mjs",
    "optional-dictionaries:test": "node scripts/test-optional-dictionaries.mjs",
    "word-levels:test": "node scripts/test-word-levels.mjs",
    "furigana:test": "node scripts/test-furigana.mjs",
    "word-levels:build": "python scripts/build_word_levels.py",
    "dictionary:build:wiktionary": "node scripts/build-wiktionary-dictionary.mjs",
    "dictionary:build:jmdict": "python scripts/build_jmdict_language.py",
    "drive:test": "node scripts/test-google-drive-layout.mjs",
    "android:add": "npm run build:web && cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run build",
    "android:build:release": "npm run build",
    "android:build:debug": "npm run build:web && cap sync android && node scripts/build-android.mjs debug",
    "dictionary:update": "python scripts/update_jmdict_en.py",
    "icon:generate": "npx @capacitor/assets generate --android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-social-login": "^8.5.12",
    "jszip": "^3.10.1",
    "kuromoji": "^0.1.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
